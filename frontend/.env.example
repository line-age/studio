# Copy to .env.local (ignored by git) and fill in. Never commit a token.

# Mapbox public access token (starts with pk.). Restrict it to your URLs in
# your Mapbox account. Without it the app runs and the map area says so.
VITE_MAPBOX_TOKEN=

# Optional: read your own fixture instead of public/fixtures/sample.json.
# See docs/fixtures.md.
# VITE_FIXTURE_URL=/fixtures/local/network.json
