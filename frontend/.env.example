# Copy to .env.local (ignored by git) and fill in. Never commit a token.

# Mapbox public access token (starts with pk.). Restrict it to your URLs in
# your Mapbox account. Without it the app runs and the map area says so.
VITE_MAPBOX_TOKEN=

# Optional: read the Lineage store instead of a fixture file. Needs a store
# running (see the repo README) and a token for it. STORE_URL and STORE_TOKEN
# stay on the server side: the dev server and nginx add the token to requests
# for /store, so it is never in the bundle or the browser.
# VITE_DATA_SOURCE=store
# STORE_URL=http://localhost:47110
# STORE_TOKEN=

# Optional: read your own fixture instead of public/fixtures/sample.json.
# See docs/fixtures.md.
# VITE_FIXTURE_URL=/fixtures/local/network.json
