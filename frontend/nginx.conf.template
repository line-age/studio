# The image's nginx: Studio's files only. The local build (VITE_AUTH=local)
# uses nginx.local.conf.template instead, which also passes /store on with the
# fixed local token.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Vite puts a content hash in every file name under /assets/.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Fixtures are data, not routes: a missing one is a 404, not the app shell.
  location /fixtures/ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }

  # No /store or /agent here: on store's data the gate sits in front of this
  # container and answers them, adding the signed-in person's token. This
  # image never adds a token of its own.

  # Single-page app: any other path gets the shell, which must not be cached.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
