{
  "dependencies": ["."],
  "graphs": {
    "agent": "./graph.py:graph"
  },
  "env": ".env.qa",
  "checkpointer": {
    "ttl": { "strategy": "keep_latest", "default_ttl": 1440, "sweep_interval_minutes": 60 }
  },
  "http": {
    "cors": {
      "allow_origins": ["http://127.0.0.1:47190"],
      "allow_methods": ["GET", "POST", "DELETE"],
      "allow_headers": ["content-type"],
      "allow_credentials": false
    }
  }
}
