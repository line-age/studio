{"id": "B02-002", "behaviour": "B02", "world": "small", "question": {"words": "Who operates this section?", "about": [{"kind": "section", "code": "s05"}]}, "must": {"refs": ["s05.operator.accepted", "s05.operator.accepted#1"], "text": ["Example Pipe Line Co.", "Sample Gas Co."]}, "must_not": {"kinds": ["unknown", "failure", "refusal", "clarify"], "text": ["with no date given"]}, "split": "dev", "keeps": null, "labeled_by": "agent-draft", "note": "Two accepted operators whose periods overlap. Both kept, neither picked."}
{"id": "B02-003", "behaviour": "B02", "world": "small", "question": {"words": "What do we know about the owner here?", "about": [{"kind": "section", "code": "s03"}]}, "must": {"refs": ["s03.owner.candidate"], "text": ["propos"]}, "must_not": {"kinds": ["failure", "refusal", "clarify"], "text": ["with no date given"]}, "split": "dev", "keeps": null, "labeled_by": "agent-draft", "note": "A candidate is called a proposal, and by a tool."}
