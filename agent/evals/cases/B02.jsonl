{"id": "B02-001", "behaviour": "B02", "world": "small", "question": {"words": "What do we know about this section?", "about": [{"kind": "section", "code": "s02"}]}, "must": {"refs": ["s02.owner.accepted", "s02.diameter.accepted"], "text": ["Example Pipe Line Co.", "20 in"], "tools": ["read_feature"]}, "must_not": {"kinds": ["failure", "refusal", "clarify"], "text": ["with no date in store"]}, "split": "dev", "keeps": null, "labeled_by": "agent-draft", "note": "One statement per claim, each with its reference."}
