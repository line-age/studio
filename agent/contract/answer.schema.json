{
  "$defs": {
    "CitationRequest": {
      "additionalProperties": false,
      "description": "What a citation request to store would hold (`POST /citation-requests`).",
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "attribute_keys": {
          "items": {
            "type": "string"
          },
          "title": "Attribute Keys",
          "type": "array"
        },
        "priority": {
          "default": "interactive",
          "enum": [
            "interactive",
            "background"
          ],
          "title": "Priority",
          "type": "string"
        },
        "hints": {
          "items": {
            "$ref": "#/$defs/Hint"
          },
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "feature_id",
        "attribute_keys"
      ],
      "title": "CitationRequest",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "description": "A lead handed to cite with a citation request: where to look, not what is true.",
      "properties": {
        "rule": {
          "enum": [
            "neighbour_source",
            "neighbour_owner",
            "pipeline_claims",
            "edition_window",
            "proposed_link",
            "rejected_value",
            "conflict"
          ],
          "title": "Rule",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "text"
      ],
      "title": "Hint",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "What a statement rests on, by store id, so Studio can open it.",
      "properties": {
        "type": {
          "enum": [
            "claim",
            "citation",
            "link",
            "feature",
            "source",
            "help",
            "set"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "candidate",
                "rejected",
                "proposed",
                "confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "asserter": {
          "anyOf": [
            {
              "enum": [
                "person",
                "pipeline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserter"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "unknown",
            "set",
            "reading",
            "help",
            "clarify",
            "refusal",
            "greeting",
            "failure",
            "citation_request",
            "worked_out",
            "lead"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "enum": [
                "neighbour_source",
                "neighbour_owner",
                "pipeline_claims",
                "edition_window",
                "proposed_link",
                "rejected_value",
                "conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only an answer that passed the grounding check is `checked`, and Studio shows no\nother.",
  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "checked": {
      "default": false,
      "title": "Checked",
      "type": "boolean"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "title": "Statements",
      "type": "array"
    }
  },
  "required": [
    "statements"
  ],
  "title": "Answer",
  "type": "object"
}
