{
  "$defs": {
    "ChangeBasis": {
      "additionalProperties": false,
      "description": "What a section was when the offer was made. Studio compares it with what it reads\nbefore it writes: a section that moved since is out of date, and nothing is sent.",
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "pipeline_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        }
      },
      "required": [
        "section_id"
      ],
      "title": "ChangeBasis",
      "type": "object"
    },
    "ChangeOffer": {
      "additionalProperties": false,
      "description": "A change asked for in words, as code read it (change_flow.py). Studio makes it on\nApprove through the same write as its menu and modals; the Agent writes nothing.\n\nadd, move: put `section_ids` in `pipeline_id`. remove: take them out of their own\npipeline. make: a new pipeline of them, named `name` if given. rename: `pipeline_id`\ngets the name `name`. edit: `attribute` gets `value`, as typed text Studio's rules\nread, on `section_ids` or, with no sections, on `pipeline_id`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "add",
            "move",
            "remove",
            "make",
            "rename",
            "edit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "pipeline_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "left_out": {
          "items": {
            "type": "string"
          },
          "title": "Left Out",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/ChangeBasis"
          },
          "title": "Basis",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ChangeOffer",
      "type": "object"
    },
    "CitationRequest": {
      "additionalProperties": false,
      "description": "What a citation request to store would hold (`POST /citation-requests`).",
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "attribute_keys": {
          "items": {
            "type": "string"
          },
          "title": "Attribute Keys",
          "type": "array"
        },
        "priority": {
          "default": "interactive",
          "enum": [
            "interactive",
            "background"
          ],
          "title": "Priority",
          "type": "string"
        },
        "hints": {
          "items": {
            "$ref": "#/$defs/Hint"
          },
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "feature_id",
        "attribute_keys"
      ],
      "title": "CitationRequest",
      "type": "object"
    },
    "EditOffer": {
      "additionalProperties": false,
      "description": "What an edit_offer fills Studio's Edit form with. The person checks it, adds the\nsource and saves; the Agent writes nothing.",
      "properties": {
        "target": {
          "enum": [
            "sections",
            "pipeline"
          ],
          "title": "Target",
          "type": "string"
        },
        "feature_ids": {
          "items": {
            "type": "string"
          },
          "title": "Feature Ids",
          "type": "array"
        },
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "target",
        "feature_ids",
        "attribute",
        "value"
      ],
      "title": "EditOffer",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A passage cite found and checked, for one attribute of one section. Not in store\nuntil the person proposes it; then it is a candidate claim, never more.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "attribute": {
          "enum": [
            "owner",
            "diameter",
            "built"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "date_words": {
          "title": "Date Words",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/FindingCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "lead": {
          "default": false,
          "title": "Lead",
          "type": "boolean"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/FindingFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "places_matched": {
          "items": {
            "type": "string"
          },
          "title": "Places Matched",
          "type": "array"
        },
        "places_given": {
          "items": {
            "type": "string"
          },
          "title": "Places Given",
          "type": "array"
        },
        "in_store": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "candidate",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Store"
        },
        "proposable": {
          "default": true,
          "title": "Proposable",
          "type": "boolean"
        },
        "not_proposable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Proposable"
        }
      },
      "required": [
        "handle",
        "section_id",
        "attribute",
        "value",
        "date_words",
        "quote",
        "source",
        "title",
        "url",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCheck": {
      "additionalProperties": false,
      "description": "One check behind a finding's confidence, in words a person reads.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "label",
        "passed"
      ],
      "title": "FindingCheck",
      "type": "object"
    },
    "FindingFlag": {
      "additionalProperties": false,
      "description": "Why a finding is in doubt, in code's words (or the reviewer model's, for unclear).",
      "properties": {
        "flag": {
          "title": "Flag",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "flag",
        "reason"
      ],
      "title": "FindingFlag",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "description": "A lead handed to cite with a citation request: where to look, not what is true.",
      "properties": {
        "rule": {
          "enum": [
            "neighbour_source",
            "neighbour_owner",
            "pipeline_claims",
            "edition_window",
            "proposed_link",
            "rejected_value",
            "conflict"
          ],
          "title": "Rule",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "rule",
        "text"
      ],
      "title": "Hint",
      "type": "object"
    },
    "PipelineOffer": {
      "additionalProperties": false,
      "description": "What a pipeline_offer would propose: Studio sends `section_ids` back, unchanged, in\nthe action propose_pipeline. `in_pipeline`: those already confirmed in a pipeline;\nthey are proposed too, and stay where they are until a person moves them.",
      "properties": {
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "in_pipeline": {
          "items": {
            "type": "string"
          },
          "title": "In Pipeline",
          "type": "array"
        }
      },
      "required": [
        "section_ids"
      ],
      "title": "PipelineOffer",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "What a statement rests on, by store id, so Studio can open it.",
      "properties": {
        "type": {
          "enum": [
            "claim",
            "citation",
            "link",
            "feature",
            "source",
            "help",
            "set"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "candidate",
                "rejected",
                "proposed",
                "confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "asserter": {
          "anyOf": [
            {
              "enum": [
                "person",
                "pipeline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserter"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SearchOffer": {
      "additionalProperties": false,
      "description": "A search the guard let through, read out before it runs. Studio sends its id back\nin the action search; the request itself stays in the thread, so nothing Studio sends\ncan change what is searched.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "attributes": {
          "items": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "array"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "title": "Years",
          "type": "array"
        },
        "places": {
          "items": {
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "from_line": {
          "default": false,
          "title": "From Line",
          "type": "boolean"
        },
        "ready": {
          "default": true,
          "title": "Ready",
          "type": "boolean"
        },
        "web_searches": {
          "default": 6,
          "title": "Web Searches",
          "type": "integer"
        },
        "pages": {
          "default": 6,
          "title": "Pages",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "section_id",
        "attributes"
      ],
      "title": "SearchOffer",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "answer",
            "fact",
            "unknown",
            "set",
            "reading",
            "help",
            "clarify",
            "refusal",
            "greeting",
            "failure",
            "citation_request",
            "worked_out",
            "lead",
            "finding",
            "searched",
            "ask_places",
            "proposed",
            "pipeline_offer",
            "edit_offer",
            "not_yet",
            "change_offer",
            "search_offer",
            "changed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "enum": [
                "neighbour_source",
                "neighbour_owner",
                "pipeline_claims",
                "edition_window",
                "proposed_link",
                "rejected_value",
                "conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "finding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pipeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only an answer that passed the grounding check is `checked`, and Studio shows no\nother.",
  "properties": {
    "version": {
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "checked": {
      "default": false,
      "title": "Checked",
      "type": "boolean"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "title": "Statements",
      "type": "array"
    },
    "carried": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Carried",
      "type": "array"
    }
  },
  "required": [
    "statements"
  ],
  "title": "Answer",
  "type": "object"
}
