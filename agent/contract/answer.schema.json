{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "description": "A highlight rectangle, 0 to 1 of the page image.",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "Box",
      "type": "object"
    },
    "CitationRequest": {
      "additionalProperties": false,
      "description": "What a citation request to store would hold (`POST /citation-requests`).",
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "attribute_keys": {
          "items": {
            "type": "string"
          },
          "title": "Attribute Keys",
          "type": "array"
        },
        "priority": {
          "default": "interactive",
          "enum": [
            "interactive",
            "background"
          ],
          "title": "Priority",
          "type": "string"
        },
        "hints": {
          "items": {
            "$ref": "#/$defs/Hint"
          },
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "feature_id",
        "attribute_keys"
      ],
      "title": "CitationRequest",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A passage cite found and checked, for one attribute of one section. Not in store\nuntil the person proposes it; then it is a candidate claim, never more.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "attribute": {
          "enum": [
            "owner",
            "diameter",
            "built"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "date_words": {
          "title": "Date Words",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "journal": {
          "title": "Journal",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "page_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Width"
        },
        "page_height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Height"
        },
        "highlight": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "title": "Highlight",
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/FindingFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "places_matched": {
          "items": {
            "type": "string"
          },
          "title": "Places Matched",
          "type": "array"
        },
        "places_given": {
          "items": {
            "type": "string"
          },
          "title": "Places Given",
          "type": "array"
        },
        "in_store": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "candidate",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Store"
        },
        "proposable": {
          "default": true,
          "title": "Proposable",
          "type": "boolean"
        },
        "not_proposable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Proposable"
        }
      },
      "required": [
        "handle",
        "section_id",
        "attribute",
        "value",
        "date_words",
        "quote",
        "journal",
        "date",
        "page",
        "url"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingFlag": {
      "additionalProperties": false,
      "description": "Why a finding is in doubt, in code's words (or the reviewer model's, for unclear).",
      "properties": {
        "flag": {
          "title": "Flag",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "flag",
        "reason"
      ],
      "title": "FindingFlag",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "description": "A lead handed to cite with a citation request: where to look, not what is true.",
      "properties": {
        "rule": {
          "enum": [
            "neighbour_source",
            "neighbour_owner",
            "pipeline_claims",
            "edition_window",
            "proposed_link",
            "rejected_value",
            "conflict"
          ],
          "title": "Rule",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "rule",
        "text"
      ],
      "title": "Hint",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "What a statement rests on, by store id, so Studio can open it.",
      "properties": {
        "type": {
          "enum": [
            "claim",
            "citation",
            "link",
            "feature",
            "source",
            "help",
            "set"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "accepted",
                "candidate",
                "rejected",
                "proposed",
                "confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "asserter": {
          "anyOf": [
            {
              "enum": [
                "person",
                "pipeline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserter"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "fact",
            "unknown",
            "set",
            "reading",
            "help",
            "clarify",
            "refusal",
            "greeting",
            "failure",
            "citation_request",
            "worked_out",
            "lead",
            "finding",
            "searched",
            "ask_places",
            "proposed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "enum": [
                "neighbour_source",
                "neighbour_owner",
                "pipeline_claims",
                "edition_window",
                "proposed_link",
                "rejected_value",
                "conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "finding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only an answer that passed the grounding check is `checked`, and Studio shows no\nother.",
  "properties": {
    "version": {
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "checked": {
      "default": false,
      "title": "Checked",
      "type": "boolean"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "title": "Statements",
      "type": "array"
    }
  },
  "required": [
    "statements"
  ],
  "title": "Answer",
  "type": "object"
}
