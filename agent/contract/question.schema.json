{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A button the person pressed, not words: code acts on it, no model reads it.\n\npropose: write a finding to store as a candidate claim, on its section or, by\n`target`, on the pipeline that section is confirmed part of.\npropose_pipeline: write a new pipeline (a line) with a proposed part_of link for each\nof `section_ids`; a person decides it.\nfresh_start: drop the conversation's messages, keep what cite found.",
      "properties": {
        "kind": {
          "enum": [
            "propose",
            "propose_pipeline",
            "fresh_start"
          ],
          "title": "Kind",
          "type": "string"
        },
        "finding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "section_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Ids"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "QuestionItem": {
      "additionalProperties": false,
      "description": "One attached thing: its kind and store id, or where it is when it has no id.",
      "properties": {
        "kind": {
          "enum": [
            "pipeline",
            "section",
            "claim",
            "citation",
            "link"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "on": {
          "anyOf": [
            {
              "$ref": "#/$defs/Where"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "QuestionItem",
      "type": "object"
    },
    "Where": {
      "additionalProperties": false,
      "properties": {
        "sectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sectionid"
        },
        "pipelineId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipelineid"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        }
      },
      "title": "Where",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything a question carries. The selection, the map view and the filters are\nnot sent: \"this\" means what is attached.",
  "properties": {
    "words": {
      "title": "Words",
      "type": "string"
    },
    "about": {
      "items": {
        "$ref": "#/$defs/QuestionItem"
      },
      "title": "About",
      "type": "array"
    },
    "network": {
      "default": "gas",
      "title": "Network",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/Action"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "words"
  ],
  "title": "Question",
  "type": "object"
}
