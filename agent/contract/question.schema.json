{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "A button the person pressed, not words: code acts on it, no model reads it.\n\npropose: write a finding to store as a candidate claim, on its section or, by\n`target`, on the pipeline that section is confirmed part of.\nsearch: start the search a search_offer in this thread offered, by its id.\noutcome: what came of a card (a change offer, a search offer, a finding), by its id\nor handle: recorded in the thread, so every reader sees the card's state. Nothing is\nwritten to store; a change was made by Studio, as the person, before this is sent.\nfresh_start: drop the conversation's messages, keep what cite found.",
      "properties": {
        "kind": {
          "enum": [
            "propose",
            "search",
            "outcome",
            "fresh_start"
          ],
          "title": "Kind",
          "type": "string"
        },
        "finding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "offer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offer"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "done",
                "declined",
                "failed",
                "out_of_date",
                "dismissed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "QuestionItem": {
      "additionalProperties": false,
      "description": "One attached thing: its kind and store id, or where it is when it has no id.",
      "properties": {
        "kind": {
          "enum": [
            "pipeline",
            "section",
            "claim",
            "citation",
            "link"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "on": {
          "anyOf": [
            {
              "$ref": "#/$defs/Where"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "QuestionItem",
      "type": "object"
    },
    "Where": {
      "additionalProperties": false,
      "properties": {
        "sectionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sectionid"
        },
        "pipelineId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipelineid"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        }
      },
      "title": "Where",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything a question carries. The selection, the map view and the filters are\nnot sent: \"this\" means what is attached.",
  "properties": {
    "words": {
      "title": "Words",
      "type": "string"
    },
    "about": {
      "items": {
        "$ref": "#/$defs/QuestionItem"
      },
      "title": "About",
      "type": "array"
    },
    "network": {
      "default": "gas",
      "title": "Network",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/Action"
