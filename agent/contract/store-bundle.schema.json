        "link": {
          "format": "uuid",
          "title": "Link",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "confirm",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "link",
        "verdict"
      ],
      "title": "BundleReviewIn",
      "type": "object"
    },
