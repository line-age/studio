{
  "$defs": {
    "CiteAttempt": {
      "properties": {
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/CiteClaimIn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stage": {
          "enum": [
            "source",
            "verifier",
            "ruled_out",
            "judge"
          ],
          "title": "Stage",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "reason"
      ],
      "title": "CiteAttempt",
      "type": "object"
    },
    "CiteCheck": {
      "description": "One check behind a claim's confidence. cite's code decides each; no model does.",
      "properties": {
        "name": {
          "enum": [
            "quote_on_page",
            "company_near",
            "town_near",
            "date_fits",
            "second_source"
          ],
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "adds": {
          "title": "Adds",
          "type": "number"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "adds"
      ],
      "title": "CiteCheck",
      "type": "object"
    },
    "CiteCitation": {
      "description": "One quote on one document cite fetched as text: a journal issue, a web page.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "page_text": {
          "title": "Page Text",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "places_matched": {
          "items": {
            "type": "string"
          },
          "title": "Places Matched",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "source_name",
        "document",
        "title",
        "page_text",
        "url"
      ],
      "title": "CiteCitation",
      "type": "object"
    },
    "CiteClaim": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "attribute": {
          "enum": [
            "YearConstructed",
            "Ownership",
            "Size",
            "LineType"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "normalized": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Normalized",
          "type": "object"
        },
        "date_sense": {
          "enum": [
            "by",
            "laying",
            "completed",
            "in_operation"
          ],
          "title": "Date Sense",
          "type": "string"
        },
        "kind": {
          "enum": [
            "finding",
            "lead"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CiteCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "flag_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Flag Reasons",
          "type": "object"
        },
        "citation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Citation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "attribute",
        "value",
        "date_sense",
        "kind",
        "confidence",
        "citation_ids"
      ],
      "title": "CiteClaim",
      "type": "object"
    },
    "CiteClaimIn": {
      "properties": {
        "attribute": {
          "enum": [
            "YearConstructed",
            "Ownership",
            "Size",
            "LineType"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "value"
      ],
      "title": "CiteClaimIn",
      "type": "object"
    },
    "CiteLimits": {
      "properties": {
        "web_searches": {
          "$ref": "#/$defs/CiteUsed"
        },
        "pages_read": {
          "$ref": "#/$defs/CiteUsed"
        },
        "model_calls": {
          "$ref": "#/$defs/CiteUsed"
        }
      },
      "required": [
        "web_searches",
        "pages_read",
        "model_calls"
      ],
      "title": "CiteLimits",
      "type": "object"
    },
    "CiteNotRead": {
      "description": "An address cite tried to read and could not.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "url",
        "reason"
      ],
      "title": "CiteNotRead",
      "type": "object"
    },
    "CiteSearchStep": {
      "description": "One step of a search, run or not. Corpus comes first and is not available yet;\nthe web step searches the listed sources only.",
      "properties": {
        "step": {
          "enum": [
            "corpus",
            "web"
          ],
          "title": "Step",
          "type": "string"
        },
        "ran": {
          "title": "Ran",
          "type": "boolean"
        },
        "why_not": {
          "default": "",
          "title": "Why Not",
          "type": "string"
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "title": "Queries",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CiteSourceSearched"
          },
          "title": "Sources",
          "type": "array"
        },
        "pages_read": {
          "default": 0,
          "title": "Pages Read",
          "type": "integer"
        },
        "years": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Years"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "step",
        "ran"
      ],
      "title": "CiteSearchStep",
      "type": "object"
    },
    "CiteSection": {
      "properties": {
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "places": {
          "items": {
            "type": "string"
          },
          "title": "Places",
          "type": "array"
        },
        "places_given": {
          "items": {
            "type": "string"
          },
          "title": "Places Given",
          "type": "array"
        }
      },
      "title": "CiteSection",
      "type": "object"
    },
    "CiteSourceSearched": {
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "results": {
          "default": 0,
          "title": "Results",
          "type": "integer"
        },
        "pages_read": {
          "default": 0,
          "title": "Pages Read",
          "type": "integer"
        },
        "not_read": {
          "default": 0,
          "title": "Not Read",
          "type": "integer"
        }
      },
      "required": [
        "domain",
        "name"
      ],
      "title": "CiteSourceSearched",
      "type": "object"
    },
    "CiteUnknown": {
      "properties": {
        "attribute": {
          "enum": [
            "YearConstructed",
            "Ownership",
            "Size",
            "LineType"
          ],
          "title": "Attribute",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "note"
      ],
      "title": "CiteUnknown",
      "type": "object"
    },
    "CiteUsed": {
      "properties": {
        "used": {
          "title": "Used",
          "type": "integer"
        },
        "allowed": {
          "title": "Allowed",
          "type": "integer"
        }
      },
      "required": [
        "used",
        "allowed"
      ],
      "title": "CiteUsed",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "$ref": "#/$defs/CiteSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/CiteCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/CiteClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "$ref": "#/$defs/CiteUnknown"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/CiteAttempt"
      },
      "title": "Attempts",
      "type": "array"
    },
    "searched": {
      "items": {
        "$ref": "#/$defs/CiteSearchStep"
      },
      "title": "Searched",
      "type": "array"
    },
    "not_read": {
      "items": {
        "$ref": "#/$defs/CiteNotRead"
      },
      "title": "Not Read",
      "type": "array"
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/CiteLimits"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cutoff": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff"
    }
  },
  "required": [
    "schema_version",
    "status"
  ],
  "title": "CiteResult",
  "type": "object"
}
