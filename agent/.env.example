# Copy to .env (ignored by git) and fill in. Never commit a key or a token.

# The model. Needed for anything but the offline tests.
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic:claude-sonnet-5-5

# Store, read only. A pipeline token of the Agent's own (starts with lgt_).
STORE_URL=http://localhost:47110
STORE_TOKEN=

# Tracing to LangSmith. AGENT_TRACING is the only switch: the service sets every
# LANGSMITH_TRACING / LANGCHAIN_TRACING variable from it, so a key alone, or a variable
# left in a shell, never turns tracing on. A trace holds what the Agent read from store.
# Leave it false on a store with real data unless the project owner has said otherwise.
# The LangSmith workspace must be private.
AGENT_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Where traces go: this agent, in this environment. Do not also set LANGSMITH_PROJECT;
# with both set LangSmith traces nothing. Eval runs name their own destination.
LANGSMITH_AGENT_ID=lineage-studio-agent
LANGSMITH_AGENT_ENVIRONMENT=local

# No usage statistics from the dev server's command line.
LANGGRAPH_CLI_NO_ANALYTICS=1
