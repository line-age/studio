# Copy to .env (ignored by git) and fill in. Never commit a key or a token.

# The model. Needed for anything but the offline tests.
ANTHROPIC_API_KEY=
AGENT_MODEL=anthropic:claude-sonnet-5-5

# Store, read only. A pipeline token of the Agent's own (starts with lgt_).
STORE_URL=http://localhost:47110
STORE_TOKEN=

# LangSmith. Off by default: on a store with real data, tracing sends what the Agent
# reads off this machine. Turn it on for eval runs on invented data; on a real store
# only once the owner has said so. The workspace must be private.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=studio-agent-dev
